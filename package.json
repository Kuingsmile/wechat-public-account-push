{
  "name": "wechat-public-account-push",
  "version": "1.0.0",
  "description": "微信公众号推送-给老婆的浪漫",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "vite build && node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "params-log": "vite build && node --enable-source-maps --env-file-if-exists=.env dist/main.js --params-log",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "author": "Kuingsmile",
  "license": "MIT",
  "homepage": "https://github.com/Kuingsmile/wechat-public-account-push#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "jsdom": "^30.1.3",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
